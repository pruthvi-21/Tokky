CREATE TABLE token_entry (
    id TEXT NOT NULL PRIMARY KEY,
    issuer TEXT NOT NULL,
    label TEXT NOT NULL,
    thumbnail TEXT NOT NULL,
    otpInfo TEXT NOT NULL,
    createdOn INTEGER NOT NULL,
    updatedOn INTEGER NOT NULL,
    addedFrom TEXT NOT NULL,
    isArchived INTEGER NOT NULL DEFAULT 0,
    deletedOn INTEGER
);

CREATE INDEX token_entry_name_idx
ON token_entry(issuer COLLATE NOCASE, label COLLATE NOCASE);

CREATE TABLE label_entity (
    id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    name TEXT NOT NULL COLLATE NOCASE UNIQUE,
    createdOn INTEGER NOT NULL
);

CREATE TABLE token_label (
    tokenId TEXT NOT NULL,
    labelId INTEGER NOT NULL,
    PRIMARY KEY (tokenId, labelId),
    FOREIGN KEY (tokenId) REFERENCES token_entry(id) ON DELETE CASCADE,
    FOREIGN KEY (labelId) REFERENCES label_entity(id) ON DELETE CASCADE
);

CREATE INDEX token_label_label_idx ON token_label(labelId, tokenId);

getAllTokens:
SELECT * FROM token_entry
WHERE deletedOn IS NULL
ORDER BY issuer COLLATE NOCASE, label COLLATE NOCASE, createdOn;

getRecycledTokens:
SELECT * FROM token_entry
WHERE deletedOn IS NOT NULL
ORDER BY deletedOn DESC, issuer COLLATE NOCASE, label COLLATE NOCASE;

getTokensCount:
SELECT COUNT(*) FROM token_entry WHERE deletedOn IS NULL;

insertToken:
INSERT INTO token_entry (id, issuer, label, thumbnail, otpInfo, createdOn, updatedOn, addedFrom, isArchived, deletedOn)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

permanentlyDeleteToken:
DELETE FROM token_entry WHERE id = ? AND deletedOn IS NOT NULL;

deleteTokenForReplacement:
DELETE FROM token_entry WHERE id = ?;

moveTokenToRecycleBin:
UPDATE token_entry
SET deletedOn = :deletedOn,
    updatedOn = :deletedOn
WHERE id = :tokenId AND deletedOn IS NULL;

restoreToken:
UPDATE token_entry
SET deletedOn = NULL,
    updatedOn = :updatedOn
WHERE id = :tokenId
AND deletedOn IS NOT NULL
AND NOT EXISTS (
    SELECT 1 FROM token_entry AS active_token
    WHERE active_token.deletedOn IS NULL
    AND active_token.id != :tokenId
    AND active_token.issuer = token_entry.issuer COLLATE NOCASE
    AND active_token.label = token_entry.label COLLATE NOCASE
);

findTokenWithId:
SELECT * FROM token_entry WHERE id = ? AND deletedOn IS NULL;

findTokenWithName:
SELECT * FROM token_entry
WHERE issuer = :issuer COLLATE NOCASE
AND label = :label COLLATE NOCASE
AND deletedOn IS NULL
LIMIT 1;

updateToken:
UPDATE token_entry
SET issuer = ?,
    label = ?,
    thumbnail = ?,
    otpInfo = ?,
    updatedOn = ?,
    isArchived = ?
WHERE id = ? AND deletedOn IS NULL;

updateHotpInfo:
UPDATE token_entry
SET otpInfo = ?,
    updatedOn = ?
WHERE id = ? AND deletedOn IS NULL;

getAllTokenLabels:
SELECT token_label.tokenId, label_entity.name
FROM token_label
JOIN label_entity ON label_entity.id = token_label.labelId
JOIN token_entry ON token_entry.id = token_label.tokenId
WHERE token_entry.deletedOn IS NULL
ORDER BY label_entity.name COLLATE NOCASE;

getRecycledTokenLabels:
SELECT token_label.tokenId, label_entity.name
FROM token_label
JOIN label_entity ON label_entity.id = token_label.labelId
JOIN token_entry ON token_entry.id = token_label.tokenId
WHERE token_entry.deletedOn IS NOT NULL
ORDER BY label_entity.name COLLATE NOCASE;

getLabelsForToken:
SELECT label_entity.name
FROM token_label
JOIN label_entity ON label_entity.id = token_label.labelId
WHERE token_label.tokenId = :tokenId
ORDER BY label_entity.name COLLATE NOCASE;

getLabelsWithCounts:
SELECT label_entity.name, COUNT(token_entry.id) AS tokenCount
FROM label_entity
LEFT JOIN token_label ON token_label.labelId = label_entity.id
LEFT JOIN token_entry
    ON token_entry.id = token_label.tokenId
    AND token_entry.isArchived = 0
    AND token_entry.deletedOn IS NULL
WHERE EXISTS (
    SELECT 1
    FROM token_label AS visible_relation
    JOIN token_entry AS visible_token ON visible_token.id = visible_relation.tokenId
    WHERE visible_relation.labelId = label_entity.id
    AND visible_token.deletedOn IS NULL
)
GROUP BY label_entity.id
ORDER BY label_entity.name COLLATE NOCASE;

insertLabel:
INSERT OR IGNORE INTO label_entity(name, createdOn) VALUES (?, ?);

findLabelId:
SELECT id FROM label_entity WHERE name = :name COLLATE NOCASE LIMIT 1;

insertTokenLabel:
INSERT OR IGNORE INTO token_label(tokenId, labelId) VALUES (?, ?);

deleteTokenLabels:
DELETE FROM token_label WHERE tokenId = ?;

deleteRecycledTokenLabels:
DELETE FROM token_label
WHERE tokenId = :tokenId
AND EXISTS (
    SELECT 1 FROM token_entry
    WHERE token_entry.id = :tokenId
    AND token_entry.deletedOn IS NOT NULL
);

updateLabelName:
UPDATE label_entity SET name = :name WHERE id = :id;

touchTokensForLabel:
UPDATE token_entry
SET updatedOn = :updatedOn
WHERE id IN (SELECT tokenId FROM token_label WHERE labelId = :labelId);

mergeLabelRelations:
INSERT OR IGNORE INTO token_label(tokenId, labelId)
SELECT tokenId, :targetLabelId FROM token_label WHERE labelId = :sourceLabelId;

deleteTokenLabelsForLabel:
DELETE FROM token_label WHERE labelId = :labelId;

deleteLabel:
DELETE FROM label_entity WHERE id = :labelId;

deleteUnusedLabels:
DELETE FROM label_entity
WHERE NOT EXISTS (SELECT 1 FROM token_label WHERE token_label.labelId = label_entity.id);
